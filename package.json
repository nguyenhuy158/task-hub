{
  "name": "task-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "pnpm build:web && node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.sso.local --import tsx src/server.ts",
    "build": "tsc && pnpm build:web",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm api:types && tsc --noEmit && tsc -p web/tsconfig.json",
    "admin": "tsx src/admin.ts",
    "mcp": "tsx src/mcp.ts",
    "openapi:check": "tsx scripts/check-openapi.ts && tsx --test tests/openapi.test.ts",
    "api:types": "openapi-typescript openapi.yaml -o generated/api.d.ts",
    "setup": "node scripts/setup.mjs",
    "build:web": "pnpm api:types && tsc -p web/tsconfig.json && vite build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "jose": "6.2.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.25.0"
}
